{
  "format": "hypit.runtime-local@1",
  "dataRoot": ".hypit/runtimes/local",
  "credentials": {
    "local": {
      "use": "@hypit/credential-store-local"
    }
  },
  "endpoints": {
    "hypihub.default": {
      "use": "@hypit/provider-hypihub",
      "config": {
        "baseUrl": "https://hypit.ai",
        "apiKey": {
          "store": "local",
          "key": "hypihub.oauth"
        }
      }
    },
    "media.local": {
      "use": "@hypit/media-local",
      "config": {
        "ffmpegPath": "C:/Users/HASEE/AppData/Local/Hypit/tools/npm/node_modules/ffmpeg-static/ffmpeg.exe",
        "ffprobePath": "C:/Users/HASEE/AppData/Local/Hypit/tools/npm/node_modules/@ffprobe-installer/win32-x64/ffprobe.exe"
      }
    },
    "html.local": {
      "use": "@hypit/provider-html-local",
      "config": {
        "ffmpegPath": "C:/Users/HASEE/AppData/Local/Hypit/tools/npm/node_modules/ffmpeg-static/ffmpeg.exe",
        "ffprobePath": "C:/Users/HASEE/AppData/Local/Hypit/tools/npm/node_modules/@ffprobe-installer/win32-x64/ffprobe.exe",
        "browserVersion": "152.0.7928.2",
        "browserDownloadBaseUrl": "https://registry.npmmirror.com/-/binary/chrome-for-testing"
      }
    },
    "image.opencv.local": {
      "use": "@hypit/provider-image-opencv-local"
    }
  }
}
