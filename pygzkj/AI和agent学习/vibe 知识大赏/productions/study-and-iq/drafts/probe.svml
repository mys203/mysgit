<?svml using="@hypit/markup@1"?>
<svml>
  <import as="time" from="@hypit/timeline-author@1"/>
  <import as="spatial" from="@hypit/spatial@1"/>
  <import as="fonts" from="@hypit/fontsource@1"/>
  <import as="typo" from="@hypit/text-fine@1"/>
  <import as="film" from="@hypit/film@1"/>
  <import as="html" from="@hypit/html-video@1"/>
  <import as="look" source="./look.svs"/>

  <time:Clock id="clock" frame-rate="30"/>
  <time:Timeline id="tl" clock={clock} end="6s"/>
  <spatial:Canvas id="canvas" width="1280" height="720"/>
  <spatial:Frame id="full" within={canvas.bounds}
    left="0%" top="0%" right="100%" bottom="100%"/>
  <fonts:Face id="title-font" package="@fontsource-variable/inter" weight="700" style="normal"/>
  <typo:Style id="title-style" recipe={look.text.title} font={title-font}>
    <typo:Fill color="#F1E7D8"/>
  </typo:Style>
  <typo:Flow id="title" timeline={tl.timeline} within={full}
    style={title-style} during={tl.window} z="10">Probe</typo:Flow>
  <film:Film id="main" canvas={canvas.canvas} timeline={tl.timeline} appearance={look.film.main}>
    <film:Track source={title.visual}/>
  </film:Film>
  <html:Video id="final" composition={main.composition} timeline={tl.timeline}/>
</svml>
