APP_NAME=智能招聘系统
APP_ENV=development
DEBUG=true
API_PREFIX=/api/v1
# 生产环境请改为 mysql+pymysql://<user>:<password>@<host>:3306/<database>
DATABASE_URL=sqlite:///./recruit_local.db
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_REQUIRED=false
REDIS_FALLBACK_ENABLED=true
# 留空时仅开发/测试模式会生成进程级临时密钥，生产环境必须注入至少48位随机密钥
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=7
AUTO_CREATE_TABLES=true
INITIAL_ADMIN_USERNAME=admin
# 示例值留空，生产环境必须通过密钥管理系统注入强密码
INITIAL_ADMIN_PASSWORD=
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10
LLM_PROVIDER=openai
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3
# DeepSeek 兼容配置：仅当 LLM_API_KEY 未显式配置时，才使用 DEEPSEEK_API_KEY。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DeepSeek 不提供聊天模型之外的隐式 embedding 能力。
# 如需向量检索，必须单独配置 embedding 服务和凭据。
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
AI_PROMPT_VERSION=v1
AI_ALGORITHM_VERSION=v1
AI_STALE_TASK_SECONDS=3600
